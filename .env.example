# Firebase (optional). If unset, the app runs in local-demo mode (localStorage-backed
# auth + data) with zero configuration. A demo admin is seeded automatically:
#   email:    admin@nexova.demo
#   password: admin123
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe (optional). If unset, checkout runs in demo mode (no real charge).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Paystack (optional). If unset, checkout runs in demo mode (no real charge).
PAYSTACK_SECRET_KEY=

# Flutterwave (optional). If unset, checkout runs in demo mode (no real charge).
FLUTTERWAVE_SECRET_KEY=

# Used to build the Flutterwave redirect URL. Defaults to same-origin if unset.
NEXT_PUBLIC_APP_URL=
