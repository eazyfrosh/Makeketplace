# Firebase (optional). If unset, the app runs in local-demo mode (localStorage-backed
# auth + data) with zero configuration. A demo admin is seeded automatically:
#   email:    admin@nexova.demo
#   password: admin123
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe (optional). If unset, checkout runs in demo mode (no real charge).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Paystack. Use test keys while validating both flows, then replace them with
# live keys in Production. Never expose the secret through NEXT_PUBLIC_*.
# Configure one Paystack webhook for:
#   https://YOUR_EAZYTOOL_DOMAIN/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Create matching Monthly (NGN 35,000) and Annual (NGN 250,000) recurring
# plans in Paystack, then paste their PLN_* codes below.
PAYSTACK_ALL_ACCESS_MONTHLY_PLAN_CODE=
PAYSTACK_ALL_ACCESS_YEARLY_PLAN_CODE=

# Closed-loop EazyTools wallet limits, expressed in kobo (minor units).
# ₦1,000 = 100000. PAYSTACK_SECRET_KEY above is also required for funding.
WALLET_MIN_DEPOSIT_MINOR=100000
WALLET_MAX_SINGLE_DEPOSIT_MINOR=100000000
WALLET_MAX_BALANCE_MINOR=500000000
WALLET_MAX_DAILY_FUNDING_MINOR=200000000

# Flutterwave (optional). If unset, checkout runs in demo mode (no real charge).
FLUTTERWAVE_SECRET_KEY=

# Used to build the Paystack/Flutterwave callback URL. Set this to your real
# deployment URL for redirect-based payments to be able to find their way back.
NEXT_PUBLIC_APP_URL=

# Public standalone SkyBook origin used by airline itinerary and boarding-pass
# QR codes. Keep this as an origin only (no trailing route).
NEXT_PUBLIC_FLIGHTBOOK_ORIGIN=https://flightbook-dusky.vercel.app

# Licensing: signs/verifies the short-lived access tokens issued when a
# customer clicks "Access". If unset, a random secret is generated per server
# boot (fine for local dev; set a real value in production so tokens survive
# restarts/multiple instances).
LICENSE_JWT_SECRET=

# Optional override for the trusted external Volterra deployment. The default
# production origin is https://tesla-blush-nine.vercel.app.
VOLTERRA_APP_ORIGIN=
ELITE_BROKER_APP_ORIGIN=https://premium-broker-platform.vercel.app

# Banking Platform: signs/verifies the sign-in session issued after a
# licensee signs up/signs in with their banking email+password. If unset, a
# random secret is generated per server boot (fine for local dev; set a real
# value in production so banking sessions survive restarts/multiple instances).
BANKING_SESSION_JWT_SECRET=

# Firebase Admin (optional). Lets the licensing backend write licenses/orders
# durably to Firestore via a service account, and verify caller identity
# without needing this. If unset, licenses/orders are held in server memory
# (reset on restart) — fine for a demo, not for production. Generate a
# service account key from Firebase Console -> Project settings -> Service
# accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# NovaBank single sign-on (optional). Shared secret authenticating this
# server's requests to novabankofficial.app's /api/sso/provision endpoint,
# used by the Banking Platform's "Open in NovaBank" handoff. Must match the
# NOVABANK_SSO_SHARED_SECRET set on the novabankofficial.app deployment
# exactly. If unset, the handoff button shows a clear "not configured" error
# instead of failing silently.
NOVABANK_SSO_SHARED_SECRET=

# Email (optional). If unset, license/receipt emails are logged to the
# console instead of sent — no real provider required to test the flow.
RESEND_API_KEY=
EMAIL_FROM=

# Email Designer uses strict transactional delivery: the sender domain must be
# verified in Resend and provider events must pass webhook verification.
# Configure the webhook endpoint as /api/email-flash/webhook.
RESEND_WEBHOOK_SECRET=

# ResellerClub registrar integration (server-only). Registration remains
# disabled until every required value is present. Production API base URL is
# commonly https://httpapi.com; use ResellerClub's demo account and documented
# test URL for testing. Never mix live credentials with the test endpoint.
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_API_KEY=
RESELLERCLUB_API_BASE_URL=
# EazyTool creates a separate ResellerClub customer and registration contact
# for each authenticated buyer. Their provider IDs are stored server-side in
# Firestore; no global customer or contact ID is used.
RESELLERCLUB_DEFAULT_PHONE_CC=234
RESELLERCLUB_ACCOUNT_CURRENCY=USD
RESELLERCLUB_DEFAULT_NAMESERVERS=ns1.example.com,ns2.example.com
# ResellerClub accepts API calls only from explicitly whitelisted static IPs.
# This value documents the configured egress IP; the app does not consume it.
RESELLERCLUB_ALLOWED_SERVER_IP=
RESELLERCLUB_CONNECTOR_URL=https://connector.eazytool.app
RESELLERCLUB_CONNECTOR_SECRET=
# A release certification gate. Keep false until a controlled registration,
# automatic wallet reversal and Paystack reconciliation have all passed.
DOMAIN_REGISTRATION_CERTIFIED=false
# Keep false until live registration, refund and reconciliation testing is approved.
DOMAIN_PURCHASES_ENABLED=false

# Email-domain abuse controls and verification cron. Resend is the initial
# EmailDomainProvider; RESEND_API_KEY and RESEND_WEBHOOK_SECRET above activate it.
EMAIL_DOMAIN_HOURLY_LIMIT=50
CRON_SECRET=

# Twilio SMS (server-only). Messaging Service is optional: when blank, the
# Twilio SMS-capable phone number is used. Keep trial mode enabled until the
# Twilio account is upgraded and production sending has been approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_TRIAL_MODE=true
SMS_RATE_LIMIT_PER_MINUTE=5
# Future production-only wallet pricing in kobo per SMS segment.
SMS_PRICE_PER_SEGMENT_MINOR=

# Authentication brute-force protection.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
