rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Profiles: each user creates/reads/updates their own, but only an admin
    // may set or change the `role` field — otherwise a user could grant
    // themselves admin by writing their own profile document. `resource`
    // doesn't exist yet on create, so that case is checked separately from
    // update.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == "customer";
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders/licenses/validation logs are issued exclusively by the
    // server-side licensing API (via Firebase Admin SDK, which bypasses
    // these rules entirely) after independently re-verifying payment with
    // the provider. The client never has a legitimate reason to read or
    // write these directly — all customer/admin views go through the
    // authenticated /api/checkout and /api/licenses endpoints instead.
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /licenses/{licenseId} {
      allow read, write: if false;
    }
    match /licenseValidationLogs/{logId} {
      allow read, write: if false;
    }

    // Logistics Platform shipments/tracking events — same server-mediated-only
    // pattern as orders/licenses above, via the authenticated /api/logistics
    // endpoints (Admin SDK bypasses these rules).
    match /logisticsShipments/{shipmentId} {
      allow read, write: if false;
    }
    match /logisticsTrackingEvents/{eventId} {
      allow read, write: if false;
    }

    // Banking Platform accounts/cards/transactions/PIN profiles/rate limits —
    // same server-mediated-only pattern, via the authenticated /api/banking
    // endpoints (Admin SDK bypasses these rules). Balances and card secrets
    // must never be directly readable or writable by the client.
    match /bankingAccounts/{accountId} {
      allow read, write: if false;
    }
    match /bankingCards/{cardId} {
      allow read, write: if false;
    }
    match /bankingTransactions/{transactionId} {
      allow read, write: if false;
    }
    match /bankingProfiles/{profileId} {
      allow read, write: if false;
    }
    match /bankingRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Website Design configs — same server-mediated-only pattern, via the
    // authenticated /api/website endpoints (Admin SDK bypasses these rules).
    match /websiteConfigs/{configId} {
      allow read, write: if false;
    }

    // Support tickets: owner or admin only.
    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
