rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Profiles: each user creates/reads/updates their own, but only an admin
    // may set or change the `role` field — otherwise a user could grant
    // themselves admin by writing their own profile document. `resource`
    // doesn't exist yet on create, so that case is checked separately from
    // update.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == "customer";
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders/licenses/validation logs are issued exclusively by the
    // server-side licensing API (via Firebase Admin SDK, which bypasses
    // these rules entirely) after independently re-verifying payment with
    // the provider. The client never has a legitimate reason to read or
    // write these directly — all customer/admin views go through the
    // authenticated /api/checkout and /api/licenses endpoints instead.
    match /orders/{orderId} {
      allow read, write: if false;
    }
    match /licenses/{licenseId} {
      allow read, write: if false;
    }
    match /licenseValidationLogs/{logId} {
      allow read, write: if false;
    }

    // Logistics Platform shipments/tracking events — same server-mediated-only
    // pattern as orders/licenses above, via the authenticated /api/logistics
    // endpoints (Admin SDK bypasses these rules).
    match /logisticsShipments/{shipmentId} {
      allow read, write: if false;
    }
    match /logisticsTrackingEvents/{eventId} {
      allow read, write: if false;
    }
    match /logisticsMessages/{messageId} {
      allow read, write: if false;
    }

    // Banking Platform accounts/cards/transactions/PIN profiles/rate limits —
    // same server-mediated-only pattern, via the authenticated /api/banking
    // endpoints (Admin SDK bypasses these rules). Balances and card secrets
    // must never be directly readable or writable by the client.
    match /bankingAccounts/{accountId} {
      allow read, write: if false;
    }
    match /bankingCards/{cardId} {
      allow read, write: if false;
    }
    match /bankingTransactions/{transactionId} {
      allow read, write: if false;
    }
    match /bankingProfiles/{profileId} {
      allow read, write: if false;
    }
    match /bankingRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Website Design configs — same server-mediated-only pattern, via the
    // authenticated /api/website endpoints (Admin SDK bypasses these rules).
    match /websiteConfigs/{configId} {
      allow read, write: if false;
    }

    // Affiliate accounts/referrals/commissions/payout requests — same
    // server-mediated-only pattern, via the authenticated /api/affiliate
    // endpoints (Admin SDK bypasses these rules). Commission amounts and
    // referral attribution must never be directly writable by the client.
    match /affiliates/{affiliateId} {
      allow read, write: if false;
    }
    match /affiliateReferrals/{referralId} {
      allow read, write: if false;
    }
    match /affiliateCommissions/{commissionId} {
      allow read, write: if false;
    }
    match /affiliatePayoutRequests/{payoutRequestId} {
      allow read, write: if false;
    }

    // Wallet balances, funding intents, immutable ledger entries, and audit
    // logs are server-mediated only. Authenticated owner/admin reads are also
    // served through APIs so field-level financial data is never exposed by
    // broad client SDK queries. Firebase Admin performs verified atomic writes.
    match /wallets/{userId} { allow read, write: if false; }
    match /wallet_transactions/{transactionId} { allow read, write: if false; }
    match /wallet_funding_intents/{intentId} { allow read, write: if false; }
    match /wallet_audit_logs/{logId} { allow read, write: if false; }

    // Subscription payment intents, verified payment history, subscription
    // state, and Paystack event-id records are server-mediated only. The
    // browser uses authenticated APIs and cannot activate itself directly.
    match /subscriptionPlans/{planId} { allow read, write: if false; }
    match /subscriptions/{subscriptionId} { allow read, write: if false; }
    match /subscriptionPayments/{paymentId} { allow read, write: if false; }
    match /subscriptionPaymentIntents/{intentId} { allow read, write: if false; }
    match /paystackProviderEvents/{eventId} { allow read, write: if false; }

    // Email Designer templates, delivery records, audit events, and rate-limit
    // counters are only exposed through authenticated server routes. This
    // prevents customers from forging delivery state or reading another
    // customer's recipients and transaction references with the client SDK.
    match /receiptEmailTemplates/{templateId} { allow read, write: if false; }
    match /receiptEmailSends/{sendId} { allow read, write: if false; }
    match /receiptEmailAuditLogs/{logId} { allow read, write: if false; }
    match /receiptEmailRateLimits/{userId} { allow read, write: if false; }
    match /emailDesignerTemplates/{templateId} { allow read, write: if false; }
    match /emailDesignerSends/{sendId} { allow read, write: if false; }
    match /emailDesignerAuditLogs/{logId} { allow read, write: if false; }
    match /emailDesignerRateLimits/{userId} { allow read, write: if false; }

    // Purchased domains, registrar orders, email-domain verification, sender
    // identities, provider events, suppressions and audit records are exposed
    // only through authenticated server routes. This prevents ownership,
    // verification, From addresses and delivery state being forged by clients.
    match /domains/{domainId} { allow read, write: if false; }
    match /domainOrders/{orderId} { allow read, write: if false; }
    match /domainRegistrarAccounts/{userId} { allow read, write: if false; }
    match /emailDomains/{domainId} { allow read, write: if false; }
    match /emailSenderIdentities/{senderId} { allow read, write: if false; }
    match /emailProviderEvents/{eventId} { allow read, write: if false; }
    match /emailSuppressions/{suppressionId} { allow read, write: if false; }
    match /emailDomainAuditLogs/{logId} { allow read, write: if false; }

    // SMS sends, status changes, rate counters and suspension settings are
    // server-mediated. Customers read their own history through /api/sms.
    match /sms_messages/{messageId} { allow read, write: if false; }
    match /sms_requests/{requestId} { allow read, write: if false; }
    match /sms_rate_limits/{rateLimitId} { allow read, write: if false; }
    match /sms_settings/{userId} { allow read, write: if false; }
    match /auth_login_limits/{limitId} { allow read, write: if false; }

    // Support tickets: owner or admin only.
    match /supportTickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /supportSites/{siteId} {
      allow read: if resource.data.status == "published" || isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId || isAdmin();
    }

    match /supportTemplates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /supportSiteTickets/{ticketId} {
      allow read, update, delete: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id','siteId','ownerId','name','email','subject','category','message','status','createdAt'])
        && exists(/databases/$(database)/documents/supportSites/$(request.resource.data.siteId))
        && get(/databases/$(database)/documents/supportSites/$(request.resource.data.siteId)).data.status == 'published'
        && get(/databases/$(database)/documents/supportSites/$(request.resource.data.siteId)).data.userId == request.resource.data.ownerId
        && request.resource.data.status == 'open'
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message.size() <= 5000;
    }
  }
}
